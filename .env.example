# Copy to .env and adjust. The shell environment overrides these values.
# The demo still starts when PostgreSQL is unset or unreachable.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_factory

# Alternative to DATABASE_URL:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=agent_factory

# PORT=3000

# Pipeline Runner LLM. The key is sent as Authorization: Bearer.
# Requests go to https://api.x.ai/v1/responses. Default model is grok-4.7.
XAI_API_KEY=your-xai-api-key
# PI_MODEL=grok-4.7
